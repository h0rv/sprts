#!/usr/bin/env python3
"""Generate team-logo marks from art sources into data files for Zig.

Usage:
    tools/generate-art --write                        # everything ESPN has
    tools/generate-art --league mlb --write           # one league
    tools/generate-art --league mlb --team PHI        # preview one team
    tools/generate-art --source local --local-root logos --write
    tools/generate-art --check                        # validate checked-in data

Without --write, prints marks to stdout so you can eyeball them.
With --write, writes packages/core/src/art/<league>/<team>.<size>.txt
(braille cells: xs=14, sm=18, md=22 wide; 4-6 rows tall), skipping files
whose checksum is unchanged, then regenerates the Zig index
(packages/core/src/art-index.zig) from whatever is on disk.

Zig consumes marks with @embedFile (see packages/core/src/art.zig), so the
checked-in artifact is plain data plus a generated index -- never hand-edit
either; rerun this tool. Add a provider by implementing the Source protocol
in tools/art_sources/ (ESPN is the first; it has no tennis/MMA/racing/golf
team logos, so a future source can fill those gaps).

Requires: python3 + pillow. ESPN is unofficial; single-digit requests per
league plus one logo fetch per team, with sleeps -- respect rate limits.
"""

import argparse
import hashlib
import sys
import time
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
ART_DIR = REPO_ROOT / "packages/core/src/art"
INDEX = REPO_ROOT / "packages/core/src/art-index.zig"

sys.path.insert(0, str(REPO_ROOT / "tools"))
import art_convert
from art_convert import SIZES
from art_sources import get_source

INDEX_HEADER = """// Generated by tools/generate-art -- do not hand-edit.
// Index over packages/core/src/art/<league>/<team>.<size>.txt
// (+ optional .color.txt sidecars; null when a team has no color yet).
// Rerun the tool after adding or removing marks.
const std = @import("std");

pub const Size = enum { xs, sm, md };

const Color = struct { xs: ?[]const u8, sm: ?[]const u8, md: ?[]const u8 };
const Entry = struct { xs: []const u8, sm: []const u8, md: []const u8, color: Color };

"""


def build_index() -> str:
    """Regenerate the Zig index from checked-in mono .txt files.

    `.color.txt` sidecars never touch this path: width math, @embedFile
    counts, and the mono audit stay byte-identical. Color embeds are
    appended per entry (null when a sidecar is missing) by build_color_arm.
    """
    leagues: dict[str, dict[str, dict[str, str]]] = {}
    colors: dict[str, dict[str, set[str]]] = {}
    for path in sorted(ART_DIR.glob("*/*.txt")):
        if path.name.endswith(".color.txt"):
            stem = path.name[: -len(".color.txt")]  # e.g. phi.xs
            abbrev, size = stem.rsplit(".", 1)
            mono_twin = path.parent / f"{stem}.txt"
            if not mono_twin.exists():
                print(f"warn: {path} has no mono twin, ignoring", file=sys.stderr)
                continue
            art_convert.check_color_file(path, mono_twin)
            colors.setdefault(path.parent.name, {}).setdefault(abbrev.upper(), set()).add(size)
            continue
        league, stem = path.parent.name, path.stem  # e.g. phi.sm
        if "." not in stem:
            print(f"warn: ignoring odd file {path}", file=sys.stderr)
            continue
        abbrev, size = stem.rsplit(".", 1)
        if size not in ("xs", "sm", "md"):
            print(f"warn: ignoring odd file {path}", file=sys.stderr)
            continue
        art_convert.check_file(path)
        leagues.setdefault(league, {}).setdefault(abbrev.upper(), {})[size] = abbrev
    chunks = [INDEX_HEADER]
    tables = []
    for league in sorted(leagues):
        entries = []
        for abbrev in sorted(leagues[league]):
            sizes = leagues[league][abbrev]
            if set(sizes) != {"xs", "sm", "md"}:
                print(f"warn: {league}/{abbrev} missing sizes {sorted(sizes)}, skipping", file=sys.stderr)
                continue
            stem = sizes["xs"]  # filename stem (lowercase)
            has = colors.get(league, {}).get(abbrev, set())
            color_arms = []
            for size in ("xs", "sm", "md"):
                if size in has:
                    color_arms.append(f'.{size} = @embedFile("art/{league}/{stem}.{size}.color.txt")')
                else:
                    if has:
                        print(f"warn: {league}/{abbrev} missing color {size}, null", file=sys.stderr)
                    color_arms.append(f".{size} = null")
            entries.append(
                f'    .{{ "{abbrev}", Entry{{ .xs = @embedFile("art/{league}/{stem}.xs.txt"),'
                f' .sm = @embedFile("art/{league}/{stem}.sm.txt"),'
                f' .md = @embedFile("art/{league}/{stem}.md.txt"),'
                f' .color = Color{{ {", ".join(color_arms)} }} }} }},'
            )
        if not entries:
            continue
        var = league.replace("-", "_")
        chunks.append(f"const {var} = std.StaticStringMap(Entry).initComptime(.{{\n" + "\n".join(entries) + "\n});\n\n")
        tables.append((league, var))
    arms = "\n".join(
        f'    if (std.ascii.eqlIgnoreCase(league_slug, "{league}")) return lookup(&{var}, abbrev_upper, size);'
        for league, var in tables
    )
    color_arms = "\n".join(
        f'    if (std.ascii.eqlIgnoreCase(league_slug, "{league}")) return lookupColor(&{var}, abbrev_upper, size);'
        for league, var in tables
    )
    chunks.append(
        "fn lookup(table: *const std.StaticStringMap(Entry), abbrev_upper: []const u8, size: Size) ?[]const u8 {\n"
        "    const entry = table.get(abbrev_upper) orelse return null;\n"
        "    return switch (size) {\n"
        "        .xs => entry.xs,\n"
        "        .sm => entry.sm,\n"
        "        .md => entry.md,\n"
        "    };\n"
        "}\n\n"
        "fn lookupColor(table: *const std.StaticStringMap(Entry), abbrev_upper: []const u8, size: Size) ?[]const u8 {\n"
        "    const entry = table.get(abbrev_upper) orelse return null;\n"
        "    return switch (size) {\n"
        "        .xs => entry.color.xs,\n"
        "        .sm => entry.color.sm,\n"
        "        .md => entry.color.md,\n"
        "    };\n"
        "}\n\n"
        "pub const leagues: []const []const u8 = &.{\n"
        + "".join(f'    "{league}",\n' for league, _ in tables)
        + "};\n\n"
        "pub fn tableFor(league_slug: []const u8) ?*const std.StaticStringMap(Entry) {\n"
        + "".join(f'    if (std.ascii.eqlIgnoreCase(league_slug, "{league}")) return &{var};\n' for league, var in tables)
        + "    return null;\n"
        "}\n\n"
        "/// abbrev_upper must already be uppercased by the caller.\n"
        "pub fn teamArt(league_slug: []const u8, abbrev_upper: []const u8, size: Size) ?[]const u8 {\n"
        f"{arms}\n"
        "    return null;\n"
        "}\n\n"
        "/// Colored twin of teamArt: SGR `38;5;N` runs over the same cells,\n"
        "/// or null when the team has no color sidecar yet (render mono).\n"
        "pub fn teamArtColor(league_slug: []const u8, abbrev_upper: []const u8, size: Size) ?[]const u8 {\n"
        f"{color_arms}\n"
        "    return null;\n"
        "}\n"
    )
    return "".join(chunks)


def write_index() -> None:
    import subprocess

    content = build_index()
    if INDEX.exists():
        old = hashlib.sha256(INDEX.read_bytes()).hexdigest()
        if old == hashlib.sha256(content.encode()).hexdigest():
            print("art-index.zig unchanged, skipping write", file=sys.stderr)
            return
    INDEX.write_text(content)
    subprocess.run(["zig", "fmt", str(INDEX)], check=True)
    print(f"wrote {INDEX.relative_to(REPO_ROOT)}", file=sys.stderr)


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--source", default="espn")
    ap.add_argument("--league", action="append", default=None, help="repeatable; default: all source leagues")
    ap.add_argument("--team", default=None, help="single abbrev filter (preview-friendly)")
    ap.add_argument("--local-root", default=None)
    ap.add_argument("--write", action="store_true")
    ap.add_argument("--check", action="store_true", help="validate checked-in files, no network")
    args = ap.parse_args()

    try:
        from PIL import Image  # noqa: F401
    except ImportError:
        raise SystemExit("pillow is required (pip install pillow)")

    if args.check:
        for path in sorted(ART_DIR.glob("*/*.txt")):
            if path.name.endswith(".color.txt"):
                continue  # validated against its mono twin below
            art_convert.check_file(path)
        for color_path in sorted(ART_DIR.glob("*/*.color.txt")):
            stem = color_path.name[: -len(".color.txt")]  # e.g. phi.xs
            mono_path = color_path.parent / f"{stem}.txt"
            if not mono_path.exists():
                raise SystemExit(f"{color_path}: mono twin {mono_path.name} missing")
            art_convert.check_color_file(color_path, mono_path)
        print("art data valid", file=sys.stderr)
        return

    source = get_source(args.source)
    if args.source == "local":
        from art_sources import local as local_mod

        source = local_mod.LocalSource(args.local_root)
    leagues = args.league or source.leagues()
    if not leagues:
        raise SystemExit(f"source {args.source} has no leagues (need --local-root?)")

    for league in leagues:
        teams = source.list_teams(league)
        if args.team:
            teams = [t for t in teams if t.abbreviation.upper() == args.team.upper()]
        print(f"{league}: {len(teams)} teams", file=sys.stderr)
        for team in teams:
            try:
                gray, rgba = art_convert.load_both(team.logo_path, team.logo_url)
                time.sleep(0.2)  # be polite to the unofficial API
            except Exception as e:  # noqa: BLE001 -- one bad logo must not kill a 1700-team run
                print(f"warn: {league}/{team.abbreviation} fetch/decode failed: {e}", file=sys.stderr)
                continue
            art = {size: art_convert.to_braille(gray, w) for (size, w) in SIZES}
            if any(not rows or not any(r.strip(art_convert.BLANK) for r in rows) for rows in art.values()):
                print(f"warn: {league}/{team.abbreviation} converted to blank, skipping", file=sys.stderr)
                continue
            try:
                color = {size: art_convert.to_braille_color(gray, rgba, w) for (size, w) in SIZES}
            except Exception as e:  # noqa: BLE001 -- mono wins; color is best-effort
                print(f"warn: {league}/{team.abbreviation} color failed: {e}", file=sys.stderr)
                color = {}
            for size, _ in SIZES:
                rows = art[size]
                print(f"--- {league}/{team.abbreviation} {size}: {len(rows)} rows x {max(len(r) for r in rows)} cells ---", file=sys.stderr)
                print("\n".join(rows))
            if not args.write:
                # Preview mode: also show the colored xs mark when available.
                if "xs" in color:
                    print(f"--- {league}/{team.abbreviation} xs (color) ---", file=sys.stderr)
                    print("\n".join(color["xs"]))
                continue
            out_dir = ART_DIR / league.lower()
            out_dir.mkdir(parents=True, exist_ok=True)
            stem = team.abbreviation.lower()
            for size, _ in SIZES:
                target = out_dir / f"{stem}.{size}.txt"
                content = "\n".join(art[size]) + "\n"
                if target.exists() and hashlib.sha256(target.read_bytes()).hexdigest() == hashlib.sha256(content.encode()).hexdigest():
                    print(f"unchanged, skipping {target.relative_to(REPO_ROOT)}", file=sys.stderr)
                else:
                    target.write_text(content, encoding="utf-8")
                    print(f"wrote {target.relative_to(REPO_ROOT)}", file=sys.stderr)
                if size in color:
                    color_target = out_dir / f"{stem}.{size}.color.txt"
                    color_content = "\n".join(color[size]) + "\n"
                    if (
                        color_target.exists()
                        and hashlib.sha256(color_target.read_bytes()).hexdigest()
                        == hashlib.sha256(color_content.encode()).hexdigest()
                    ):
                        print(f"unchanged, skipping {color_target.relative_to(REPO_ROOT)}", file=sys.stderr)
                        continue
                    color_target.write_text(color_content, encoding="utf-8")
                    print(f"wrote {color_target.relative_to(REPO_ROOT)}", file=sys.stderr)

    if args.write and not args.team:
        write_index()


if __name__ == "__main__":
    main()
